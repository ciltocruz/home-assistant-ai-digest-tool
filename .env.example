APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
RUNTIME_MODE=local
TRUST_PROXY=false
SECURE_COOKIES=false

# Optional browser-accessible HTTP(S) origin used for report links in Telegram.
# Do not include a path, credentials, a query string, or a fragment.
PUBLIC_APP_URL=

# Directory on the Docker host that contains home-assistant.log (mounted read-only at /ha-logs).
# Mount the directory, never a single file: Home Assistant recreates the log file and a
# single-file bind keeps serving the deleted (stale) inode forever.
# Never point this at the full HA config directory or the Docker socket.
HA_LOGS_DIR=
# Legacy fallback: HA_LOG_FILE with the full path of one existing home-assistant.log file still works.
# HA_LOG_FILE=
HA_MAX_STATES=500
HA_MAX_LOG_LINES=200
HA_MAX_RESPONSE_BYTES=1000000
HA_ANALYSIS_TIMEOUT_MS=60000
